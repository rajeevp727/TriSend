{
  "ConnectionStrings": {
    "Identity": "Server=tcp:<server>.database.windows.net,1433;Initial Catalog=TriSendIdentity;User ID=<user>;Password=<password>;Encrypt=True;TrustServerCertificate=False"
  },
  "Authentication": {
    "Issuer": "https://auth.trisend.com/",
    "AccessTokenLifetimeMinutes": 10,
    "RefreshTokenLifetimeDays": 30,
    "AllowDevelopmentCertificates": false,
    "Google": { "ClientId": "", "ClientSecret": "" },
    "Microsoft": { "Tenant": "common", "ClientId": "", "ClientSecret": "" },
    "SigningCertificateSecretNames": [],
    "EncryptionCertificateSecretNames": []
  },
  "KeyVault": { "VaultUri": "" },
  "ForwardedHeaders": { "KnownProxies": [] },
  "Cors": {
    "AllowedOrigins": [
      "https://trisend.in",
      "https://greenpantry.in",
      "https://omegatech.in",
      "https://sprintdeck.in",
      "https://248works.in"
    ]
  },
  "OAuthClients": [
    {
      "ClientId": "trisend", "DisplayName": "TriSend", "Public": false, "ClientSecret": "",
      "RedirectUris": ["https://trisend.in/auth/callback"],
      "PostLogoutRedirectUris": ["https://trisend.in/"],
      "AllowedScopes": ["greenpantry-api", "omegatech-api", "sprintdeck", "248works"]
    },
    {
      "ClientId": "greenpantry", "DisplayName": "GreenPantry", "Public": false, "ClientSecret": "",
      "RedirectUris": ["https://greenpantry.in/auth/callback"],
      "PostLogoutRedirectUris": ["https://greenpantry.in/"],
      "AllowedScopes": ["greenpantry-api"]
    },
    {
      "ClientId": "omegatech", "DisplayName": "OmegaTech", "Public": false, "ClientSecret": "",
      "RedirectUris": ["https://omegatech.in/auth/callback"],
      "PostLogoutRedirectUris": ["https://omegatech.in/"],
      "AllowedScopes": ["omegatech-api"]
    },
    {
      "ClientId": "sprintdeck", "DisplayName": "SprintDeck", "Public": true, "ClientSecret": null,
      "RedirectUris": ["https://sprintdeck.in/auth/callback"],
      "PostLogoutRedirectUris": ["https://sprintdeck.in/"],
      "AllowedScopes": ["sprintdeck"]
    },
    {
      "ClientId": "248works", "DisplayName": "248 Works", "Public": true, "ClientSecret": null,
